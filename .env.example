# Copy to .env and fill values privately. Never commit .env.
OMDB_API_KEY=

# Optional: International Showtimes API access for Oakland 94612 screenings.
# Needed only with --live-showtimes. The default demo schedule uses captured
# films, cinemas, formats, and local times adapted to the requested date.
SHOWTIMES_API_KEY=

# Model or inference-profile ID available to your AWS account.
NICOLE_MODEL=
# Optional explicit default: bedrock, anthropic, or openrouter.
NICOLE_PROVIDER=bedrock
AWS_REGION=us-west-2
# Use the standard AWS credential chain, e.g. an AWS_PROFILE or SSO session.
# AWS_PROFILE=

# Optional: nicole --provider anthropic (use an Anthropic model in NICOLE_MODEL).
ANTHROPIC_API_KEY=

# Optional: nicole --provider openrouter
# Use an OpenRouter model ID such as anthropic/claude-sonnet-4.6 in NICOLE_MODEL.
OPENROUTER_API_KEY=

# Optional: nicole --memory agentcore; provision an ACTIVE preference strategy first.
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_NAMESPACE=/nicole/{actorId}/preferences/
# Optional separate region for the memory resource; otherwise uses AWS_REGION.
# AGENTCORE_MEMORY_REGION=us-east-2
# Deployed built-in strategy input: explicit taste facts, not full exchanges.
# AGENTCORE_MEMORY_INPUT=facts

# New visits default to AgentCore and the sample cinema schedule. Use
# --runtime local for a local Worker. Deployment instructions:
# docs/CLOUD.md. Runtime credentials are loaded from Secrets Manager; do not
# copy AWS access keys into this file or into Workflow inputs.
# NICOLE_DEPLOYMENT_FILE=.demo-state/nicole/agentcore-deployment.json

# Optional SDK External Storage (Public Preview), automatically loaded for AgentCore.
# Keep the bucket and its objects available through Workflow/history retention.
# NICOLE_PAYLOAD_BUCKET=your-private-nicole-payload-bucket
# NICOLE_PAYLOAD_OWNER=123456789012
# NICOLE_PAYLOAD_REGION=us-east-2
# Default 262144 bytes; deployed demo uses 16384 to offload actual cinema listings.
# NICOLE_PAYLOAD_THRESHOLD=262144

# Temporal Cloud: set all four privately in .env. With --runtime local the Worker
# runs on your machine; the default AgentCore path requires your own deployment.
# TEMPORAL_MODE=cloud
# TEMPORAL_ADDRESS=your-namespace.your-account.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace.your-account
# TEMPORAL_API_KEY=
# Without Cloud settings, Nicole can start a local server automatically.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
